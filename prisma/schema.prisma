generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL"***REMOVED***
}

model User {
  id        Int      @id @default(autoincrement(***REMOVED******REMOVED***
  email     String   @unique
  password  String
  name      String?
  createdAt DateTime @default(now(***REMOVED******REMOVED***
  updatedAt DateTime @updatedAt
  
  posts    Post[]
  sessions Session[]
  twoFA    TwoFA?
  resets   PasswordReset[]
}

model Post {
  id        Int      @id @default(autoincrement(***REMOVED******REMOVED***
  title     String
  content   String?
  published Boolean  @default(false***REMOVED***
  authorId  Int
  createdAt DateTime @default(now(***REMOVED******REMOVED***
  updatedAt DateTime @updatedAt
  
  author User @relation(fields: [authorId], references: [id]***REMOVED***
}

model Session {
  id        Int      @id @default(autoincrement(***REMOVED******REMOVED***
  userId    Int
  token     String
  createdAt DateTime @default(now(***REMOVED******REMOVED***
  expiresAt DateTime
  
  user User @relation(fields: [userId], references: [id]***REMOVED***
}

model TwoFA {
  id      Int     @id @default(autoincrement(***REMOVED******REMOVED***
  userId  Int     @unique
  secret  String
  enabled Boolean @default(false***REMOVED***
  
  user User @relation(fields: [userId], references: [id]***REMOVED***
}

model PasswordReset {
  id        Int      @id @default(autoincrement(***REMOVED******REMOVED***
  userId    Int
  token     String
  expiresAt DateTime
  
  user User @relation(fields: [userId], references: [id]***REMOVED***
}